apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

namePrefix: dev-
namespace: ${APP_NAME}

resources:
  - ../../base

patches:
  - patch: |-
      - op: replace
        path: /spec/replicas
        value: 1
    target:
      kind: Deployment
      name: nginx
  - patch: |-
      - op: replace
        path: /metadata/name
        value: ${APP_NAME}
      - op: replace
        path: /metadata/labels/name
        value: ${APP_NAME}
    target:
      kind: Namespace
      name: default
